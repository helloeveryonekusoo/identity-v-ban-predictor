rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /matches/{matchId} {
      // update はマスターデータの名称変更を過去データへ反映するために必要。
      allow read, create, update, delete: if signedIn();
    }

    // マスターデータ（サバイバー・ハンター・マップ・シーズン）は全員で共有する。
    match /settings/global {
      allow read, write: if signedIn();
    }

    // 基本設定・予測の重み・希少Ban・既定ハンターBANは本人だけのもの。
    match /userSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
